# Copy to .env.backend and source before running `cargo run -p api`.
# `cargo run` also auto-loads .env via dotenvy, but a dedicated file keeps the
# backend config out of the frontend's .env.

DATABASE_URL=postgres://mockinterview:mockinterview@localhost:5432/mockinterview
# Optional Phase 6 read-replica DSN. When set, list_* repos read from it.
# DATABASE_REPLICA_URL=postgres://mockinterview:mockinterview@replica:5432/mockinterview
DB_MAX_CONNECTIONS=10

LISTEN_ADDR=0.0.0.0:8080
METRICS_LISTEN_ADDR=0.0.0.0:9090
WEB_BASE_URL=http://localhost:4173
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173

# Legacy bearer token. Phase 6 keeps this honored for the cutover window via
# FEATURE_LEGACY_HR_TOKEN; flip that flag off once /v1/auth/login rolls out.
HR_DEV_TOKEN=replace-me-with-a-long-random-string

# Account every legacy-token session is attributed to. Matches 0002 migration.
DEFAULT_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

SESSION_TTL_HOURS=72
DEFAULT_PASS_THRESHOLD=70

# Anthropic
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL_PRIMING=claude-sonnet-4-6
ANTHROPIC_MODEL_SCORING=claude-sonnet-4-6
ANTHROPIC_MODEL_FOLLOWUP=claude-sonnet-4-6
ANTHROPIC_MODEL_GRADING=claude-haiku-4-5-20251001

# In-process priming loop.
PRIME_POLL_INTERVAL_MS=1000
PRIME_BATCH_SIZE=4

# ─── Phase 5 ──────────────────────────────────────────────────────────────────
FEATURE_TRANSCRIPT_CHAIN=true
TRANSCRIPT_CHECKPOINT_EVERY=50
# TRANSCRIPT_SIGNING_SECRET_HEX=
TRANSCRIPT_KEY_ID=dev-v1

FEATURE_SERVER_PDF=true
S3_BUCKET=mockinterview-reports
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=mockinterview
S3_SECRET_ACCESS_KEY=mockinterview-secret
S3_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECS=600

OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=8
OUTBOX_MAX_ATTEMPTS=5

FEATURE_BACKEND_MAILER=true
RESEND_API_KEY=
MAIL_FROM_ADDRESS=reports@example.com
# MAIL_REPLY_TO=

# ─── Phase 6 ──────────────────────────────────────────────────────────────────

# JWT auth. Issued by POST /v1/auth/login; verify_access validates iss + exp.
FEATURE_JWT_AUTH=true
# Must be >= 32 bytes. Falls back to HR_DEV_TOKEN if unset (dev only).
# JWT_SIGNING_SECRET=
JWT_ISSUER=mock-interview-ai
JWT_KEY_ID=v1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
INVITE_TTL_HOURS=168

# Dual-acceptance window. Flip false after 1 week to retire the legacy token.
FEATURE_LEGACY_HR_TOKEN=true

# Cookies. Set to true in any deploy that terminates TLS at the LB.
COOKIES_SECURE=false

# Rate limits. Off by default in dev; flip ON in staging + prod.
FEATURE_RATE_LIMIT=false
RATE_LIMIT_CREATE_INTERVIEW_PER_HOUR=60
RATE_LIMIT_LOGIN_PER_MIN_IP=10
RATE_LIMIT_LOGIN_PER_HOUR_EMAIL=30
RATE_LIMIT_SESSION_BY_CODE_PER_MIN=60
RATE_LIMIT_WS_PER_MIN=10

# Redis backplane. When unset, every Phase-6 Redis subsystem degrades to its
# in-process fallback so single-pod dev keeps working.
# REDIS_URL=redis://localhost:6379
FEATURE_REDIS_OUTBOX=false
FEATURE_REDIS_NONCES=false
FEATURE_REDIS_WS_LOCKS=false

# Observability. OTLP collector at OTLP_ENDPOINT receives traces.
FEATURE_OTEL=false
# OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mock-interview-api

# KMS abstraction for transcript signing. `env` keeps the Phase 5 behaviour;
# `aws` / `gcp` / `vault` are reserved (compile-time stubs).
KMS_PROVIDER=env
# KMS_KEY_ARN=

RUST_LOG=info,sqlx=warn,tower_http=info

# =============================================================================
# Deploy-time env. Copy to `deploy/.env` and fill in the secrets before
# `docker compose pull && docker compose up -d`.
# Loaded by every service in docker-compose.yml.
# =============================================================================

# ─── Image source ────────────────────────────────────────────────────────────
# Fully qualified image reference. The EC2 pulls this; your dev machine /
# CI pushes to it.
#
# GHCR (default — recommended for GitHub repos):
APP_IMAGE=ghcr.io/your-gh-user/mock-interview-app:latest
#
# ECR alternative:
# APP_IMAGE=<account>.dkr.ecr.us-east-1.amazonaws.com/mock-interview-app:latest
#
# Docker Hub alternative:
# APP_IMAGE=your-dockerhub-user/mock-interview-app:latest

# How docker compose acquires the image on `up`:
#   missing — only pull if not local (good default; pull explicitly with `compose pull`)
#   always  — pull on every `up` (handy if you always use :latest)
#   never   — never pull (for offline / pre-loaded images via `docker save | load`)
PULL_POLICY=missing


# ─── Domain + TLS ────────────────────────────────────────────────────────────
# Caddy reads $DOMAIN at startup and obtains a Let's Encrypt cert for it.
# The DNS A record for $DOMAIN MUST point at this EC2 before first boot,
# or ACME will fail and Caddy will retry with exponential backoff.
DOMAIN=interview.example.com
ACME_EMAIL=ops@example.com

# ─── Postgres init ───────────────────────────────────────────────────────────
POSTGRES_USER=mockinterview
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mockinterview

# ─── Backend wiring ──────────────────────────────────────────────────────────
# DATABASE_URL must match POSTGRES_USER/PASSWORD/DB above and use the compose
# service name `postgres` (not localhost — we're inside the docker network).
DATABASE_URL=postgres://mockinterview:change-me-strong-password@postgres:5432/mockinterview
DB_MAX_CONNECTIONS=10
# Optional read replica. Leave unset unless you actually run one.
# DATABASE_REPLICA_URL=postgres://...:5432/mockinterview

REDIS_URL=redis://redis:6379
FEATURE_REDIS_OUTBOX=true
FEATURE_REDIS_NONCES=true
FEATURE_REDIS_WS_LOCKS=true

LISTEN_ADDR=0.0.0.0:8080
# Bind /metrics to loopback so it's never exposed even if a future change
# port-maps it. Caddy and operators reach it via `docker exec` only.
METRICS_LISTEN_ADDR=127.0.0.1:9090

# WEB_BASE_URL and CORS_ORIGINS MUST equal "https://$DOMAIN" above.
# Same-origin deployment means the browser doesn't actually trigger CORS
# preflights against this list — it's defense-in-depth against
# misconfigurations.
WEB_BASE_URL=https://interview.example.com
CORS_ORIGINS=https://interview.example.com

SESSION_TTL_HOURS=72
DEFAULT_PASS_THRESHOLD=70

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL_PRIMING=claude-sonnet-4-6
ANTHROPIC_MODEL_SCORING=claude-sonnet-4-6
ANTHROPIC_MODEL_FOLLOWUP=claude-sonnet-4-6
ANTHROPIC_MODEL_GRADING=claude-haiku-4-5-20251001

# ─── Speech-to-text (AssemblyAI streaming, always on) ────────────────────────
# ASSEMBLYAI_API_KEY is required; the server fails to start without it.
ASSEMBLYAI_API_KEY=replace-me
ASSEMBLYAI_STREAMING_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_SPEECH_MODEL=u3-rt-pro
ASSEMBLYAI_FORMAT_TURNS=true
ASSEMBLYAI_AUDIO_CHANNEL_CAPACITY=64
STT_EVENT_CHANNEL_CAPACITY=256

# In-process priming loop
PRIME_POLL_INTERVAL_MS=1000
PRIME_BATCH_SIZE=4

# ─── Transcript hash chain ───────────────────────────────────────────────────
FEATURE_TRANSCRIPT_CHAIN=true
TRANSCRIPT_CHECKPOINT_EVERY=50
TRANSCRIPT_KEY_ID=prod-v1
# 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
TRANSCRIPT_SIGNING_SECRET_HEX=replace-me-with-64-hex-chars

# ─── Event outbox dispatcher ─────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=8
OUTBOX_MAX_ATTEMPTS=5

# ─── Backend mailer (Resend) ─────────────────────────────────────────────────
FEATURE_BACKEND_MAILER=true
RESEND_API_KEY=replace-me
MAIL_FROM_ADDRESS=reports@example.com
# MAIL_REPLY_TO=

# ─── JWT auth ────────────────────────────────────────────────────────────────
FEATURE_JWT_AUTH=true
# >= 32 bytes. Generate with: openssl rand -base64 48
JWT_SIGNING_SECRET=replace-me-with-a-32-byte-or-longer-secret
JWT_ISSUER=mock-interview-ai
JWT_KEY_ID=prod-v1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
INVITE_TTL_HOURS=168

# DO NOT set HR_DEV_TOKEN in prod. It's a dev-only fallback used by
# auth.rs:58-59 when JWT_SIGNING_SECRET is missing — setting it in prod
# would let an attacker who learns the value mint admin tokens.

# TLS terminates at Caddy in the container, so cookies must be Secure.
COOKIES_SECURE=true

# ─── Rate limits (ON in prod) ────────────────────────────────────────────────
FEATURE_RATE_LIMIT=true
RATE_LIMIT_CREATE_INTERVIEW_PER_HOUR=60
RATE_LIMIT_LOGIN_PER_MIN_IP=10
RATE_LIMIT_SESSION_BY_CODE_PER_MIN=60
RATE_LIMIT_WS_PER_MIN=10

# ─── Retention worker ────────────────────────────────────────────────────────
# Hourly in-process tick that purges transcripts, answers, PII, and delivered
# outbox events after the HR report has shipped. Defaults plateau Postgres
# growth so EBS sizing stays bounded. Tune the day windows to match your
# data-retention policy; SHRINKING a window triggers a large delete on the
# next tick, so decide before first boot.
FEATURE_RETENTION_WORKER=true
RETENTION_POLL_INTERVAL_SECS=3600
RETENTION_TRANSCRIPT_DAYS=7
RETENTION_ANSWERS_DAYS=30
RETENTION_PII_DAYS=30
RETENTION_OUTBOX_DAYS=30

# ─── Observability ───────────────────────────────────────────────────────────
FEATURE_OTEL=false
# OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=mock-interview-api

RUST_LOG=info,sqlx=warn,tower_http=info
